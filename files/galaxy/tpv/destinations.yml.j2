---
# TPV (total-perspective-vortex) destinations.
# Managed by Ansible (files/galaxy/tpv/destinations.yml.j2), rendered to
# {{ _galaxy_tpv_config_dir }}/destinations.yml; local changes are overwritten.
#
# NOTE: Use dashes (-) exclusively for tags and underscores (_) exclusively for destinations
# (usegalaxy.eu convention). Routing rules and the tags jobs require are in tool_defaults.yml.j2.
#
# A destination's `scheduling.require` tags must all be required by a job for it to be
# picked; `accept` tags are allowed but not needed. So untagged jobs can only land on the
# default destination ({{ _galaxy_jobs_default }}), and Pulsar destinations only receive jobs
# whose user (or a tool mapping) asked for their `<name>-pulsar` tag.
destinations:
  ######################
  # LOCAL DESTINATIONS #
  ######################
{# The default destination accepts untagged and `internal` jobs; the others need their tag. #}
{% macro local_scheduling(name) -%}
{{ ({'accept': [name, 'internal']} if name == _galaxy_jobs_default else {'require': [name]}) | to_json }}
{%- endmacro %}

  local:
    runner: local
    env:
      - name: PATH
        action: prepend_to
        value: "{{ galaxy_mutable_data_dir }}/shed_tools:$PATH"
    scheduling: {{ local_scheduling('local') }}

  docker:
    runner: local
    params:
      docker_enabled: true
      docker_set_user:
      docker_sudo: false
      container_resolvers:  # use defaults
      outputs_to_working_directory: {{ _galaxy_use_interactive_tools | bool | to_json }}
    scheduling: {{ local_scheduling('docker') }}

  singularity:
    runner: local
    params:
      singularity_enabled: true
      singularity_volumes: {{ apptainer_volumes | join(',') | to_json }}
      outputs_to_working_directory: {{ _galaxy_use_interactive_tools | bool | to_json }}
      container_resolvers:
        - type: cached_explicit_singularity
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/explicit/"
        - type: cached_mulled_singularity
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/mulled/"
        - type: mulled_singularity
          auto_install: false
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/mulled/"
        - type: build_mulled_singularity
          auto_install: false
          cache_directory: "{{ galaxy_mutable_data_dir }}/cache/singularity/built/"
    env:
      - name: LC_ALL
        value: C
      - name: APPTAINER_CACHEDIR
        value: /tmp/singularity
      - name: APPTAINER_TMPDIR
        value: /tmp
    scheduling: {{ local_scheduling('singularity') }}

  #######################
  # PULSAR DESTINATIONS #
  #######################

  # Shared settings for remote Pulsar nodes set up like usegalaxy.eu's (BYOC onboarding);
  # destinations inheriting it ALWAYS set their own runner.
  pulsar_default:
    abstract: true
    env:
      LC_ALL: C
      SINGULARITY_CACHEDIR: /data/share/var/database/container_cache  # On the NFS share on remote Pulsar side
      TMP: $_GALAXY_JOB_TMP_DIR
      TEMP: $_GALAXY_JOB_TMP_DIR
      TMPDIR: $_GALAXY_JOB_TMP_DIR
    params:
      jobs_directory: /data/share/staging
      transport: curl
      remote_metadata: "false"
      metadata_strategy: directory
      default_file_action: remote_transfer
      rewrite_parameters: "true"
      persistence_directory: /data/share/persisted_data
      outputs_to_working_directory: "false"
      dependency_resolution: "none"
      submit_request_cpus: "{cores}"
      submit_request_memory: "{mem}G"
      docker_volumes: "$job_directory:rw,$tool_directory:ro,$job_directory/outputs:rw,$working_directory:rw,/cvmfs/data.galaxyproject.org:ro"
      singularity_volumes: "$job_directory:rw,$tool_directory:ro,$job_directory/outputs:rw,$working_directory:rw,/cvmfs/data.galaxyproject.org:ro"
      singularity_enabled: true
      singularity_default_container_id: /cvmfs/singularity.galaxyproject.org/all/centos:8.3.2011
      container_resolvers:
        - type: explicit
        - type: mulled_singularity
    scheduling:
      accept:
        - pulsar
        - conda
        - singularity
        - docker
{% for pulsar in _galaxy_pulsar_configs_raw %}
{%   set name = pulsar.name | default(pulsar.url | replace('https://', '') | replace('http://', '') | replace('.', '-') | replace('/', '-')) %}

  # Remote Pulsar "{{ name }}" over REST (src_galaxy_pulsar_configs)
  remote_{{ name }}_basic:
    runner: pulsar
    params:
      url: {{ pulsar.url | to_json }}
      private_token: {{ pulsar.private_token | to_json }}
      default_file_action: remote_transfer
      dependency_resolution: {{ pulsar.dependency_resolution | default('remote') | to_json }}
      manager: {{ pulsar.manager | default('_default_') | to_json }}
      cleanup_job: never
    scheduling:
      require:
        - {{ (name ~ '-pulsar') | to_json }}
{%   if pulsar.docker_enabled | default(false) | bool %}

  # Docker/interactive variant of "{{ name }}"; only used through src_galaxy_pulsar_tool_mappings.
  remote_{{ name }}:
    runner: pulsar
    params:
      url: {{ pulsar.url | to_json }}
      private_token: {{ pulsar.private_token | to_json }}
      default_file_action: remote_transfer
      dependency_resolution: {{ pulsar.dependency_resolution | default('remote') | to_json }}
      manager: {{ pulsar.manager | default('_default_') | to_json }}
{%     if pulsar.pulsar_root is defined %}
      jobs_directory: {{ (pulsar.pulsar_root ~ '/jobs') | to_json }}
      persistence_directory: {{ (pulsar.pulsar_root ~ '/persisted_data') | to_json }}
{%     endif %}
      docker_enabled: true
      docker_set_user: {{ pulsar.docker_set_user | default('') | to_json }}
      docker_memory: {{ pulsar.docker_memory | default('8G') | to_json }}
      docker_sudo: false
      singularity_enabled: {{ pulsar.singularity_enabled | default(false) | bool | to_json }}
      tmp_dir: {{ pulsar.tmp_dir | default(true) | bool | to_json }}
      outputs_to_working_directory: {{ pulsar.outputs_to_working_directory | default(false) | bool | to_json }}
      container_resolvers: {{ pulsar.container_resolvers | default([{'type': 'explicit'}, {'type': 'mulled'}, {'type': 'build_mulled', 'require_container': true}]) | to_json }}
      container_monitor_command: {{ pulsar.container_monitor_command | default('/mnt/pulsar/venv/bin/galaxy-container-monitor') | to_json }}
      container_monitor_result: {{ pulsar.container_monitor_result | default('callback') | to_json }}
      container_monitor_get_ip_method: {{ pulsar.container_monitor_get_ip_method | default('command:echo ' ~ (pulsar.name | default(pulsar.url | replace('https://', '') | replace('http://', '')))) | to_json }}
    scheduling:
      require:
        - {{ (name ~ '-pulsar-docker') | to_json }}
{%   endif %}
{% endfor %}
{% for pulsar in _galaxy_pulsar_amqp_configs %}

  # Remote Pulsar "{{ pulsar.name }}" over AMQP (src_galaxy_pulsar_amqp_configs)
  {{ pulsar.environment }}:
    runner: {{ pulsar.runner }}
    params:
      jobs_directory: {{ pulsar.jobs_directory | to_json }}
      default_file_action: remote_transfer
      dependency_resolution: {{ pulsar.dependency_resolution | to_json }}
      rewrite_parameters: true
      remote_metadata: false
      outputs_to_working_directory: false
      docker_enabled: {{ pulsar.docker_enabled | to_json }}
      singularity_enabled: {{ pulsar.singularity_enabled | to_json }}
    scheduling:
      require:
        - {{ (pulsar.name ~ '-pulsar') | to_json }}
{% endfor %}

  # BYOC onboarding destinations: onboarding PRs add their `pulsar_<id>_tpv` destinations
  # here, at the end of the PULSAR DESTINATIONS section and above the LOCAL CONDOR DESTINATIONS
  # banner (the place usegalaxy.eu's onboarding PRs use), in the usegalaxy.eu format:
  #
  #   pulsar_<id>_tpv:
  #     inherits: pulsar_default
  #     runner: pulsar_eu_<id>
  #     max_accepted_cores: <cores>
  #     max_accepted_mem: <GB>
  #     min_accepted_gpus: 0
  #     max_accepted_gpus: 0
  #     scheduling:
  #       require:
  #         - <id>-pulsar

  #############################
  # LOCAL CONDOR DESTINATIONS #
  #############################
  # There is no HTCondor here. The banner marks the end of the onboarding section, as on
  # usegalaxy.eu; keep it last.
