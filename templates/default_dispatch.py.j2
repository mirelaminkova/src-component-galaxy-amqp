"""Galaxy dynamic job rule ``{{ _galaxy_default_dispatcher }}``.

Managed by Ansible (templates/default_dispatch.py.j2); local changes are overwritten.

* Interactive tools run in Docker.
* A logged-in user who picked a remote (Pulsar) destination in their preferences
  ("Use distributed compute resources") gets their jobs sent there, unless the
  tool must run next to Galaxy or is pinned by a tool mapping.
* With "bring your own Pulsar" enabled, a user who picked "byoc" gets their jobs
  sent to their own Pulsar: environment ``byoc_<their byoc_pulsar|username>``,
  written by galaxy-byoc-sync with ``byoc_owner_id`` = their Galaxy user id. The
  environment is only used if that id matches, so nobody else can reach it (the
  same username typed by another user, or a stale preference, gets the default).
* Everything else goes to the default destination.

Galaxy injects ``app``, ``tool`` and ``user`` by argument name; ``user`` is None
for anonymous users.
"""

import logging
import re

log = logging.getLogger(__name__)

DEFAULT_DESTINATION = {{ _galaxy_jobs_default | to_json }}
INTERACTIVE_DESTINATION = "docker"
REMOTE_DESTINATIONS = frozenset({{ _galaxy_remote_destinations | map(attribute='id') | list | to_json }})
PREFERENCE_KEY = "distributed_compute|remote_resources"

BYOC_ENABLED = {{ 'True' if _galaxy_byoc_pulsar else 'False' }}
BYOC_CHOICE = "byoc"
BYOC_USERNAME_KEY = "byoc_pulsar|username"
BYOC_USERNAME = re.compile(r"[a-z0-9_-]{3,32}")
BYOC_OWNER_PARAM = "byoc_owner_id"

# Tools that need Galaxy's own environment, database or files (data sources and
# data managers write into Galaxy); user-defined tools must stay in Galaxy's
# isolated environment.
LOCAL_TOOL_IDS = frozenset(["upload1", "__DATA_FETCH__"])
LOCAL_TOOL_TYPES = frozenset(
    [
        "data_source",
        "data_source_async",
        "expression",
        "interactive",
        "manage_data",
        "user_defined",
    ]
)
# Tools with an explicit environment in job_conf.yml (src_galaxy_pulsar_tool_mappings).
PINNED_TOOL_IDS = frozenset({{ _galaxy_pulsar_tool_mappings | map(attribute='tool_id') | map('lower') | list | to_json }})


def _preferred_destination(user):
    if user is None:
        return None
    return user.extra_preferences.get(PREFERENCE_KEY)


def _may_run_remotely(tool):
    return not (
        tool.old_id in LOCAL_TOOL_IDS
        or tool.tool_type in LOCAL_TOOL_TYPES
        or tool.tool_type_local
        or tool.requires_galaxy_python_environment
        or PINNED_TOOL_IDS.intersection(tool.all_ids)
    )


def _own_byoc_destination(app, user):
    """The user's BYOC environment if it exists and belongs to them, else None."""
    username = user.extra_preferences.get(BYOC_USERNAME_KEY)
    if not isinstance(username, str) or not BYOC_USERNAME.fullmatch(username):
        return None
    environment = "byoc_" + username
    try:
        owner = app.job_config.get_destination(environment).params.get(BYOC_OWNER_PARAM)
    except KeyError:
        owner = None
    if owner is None or str(owner) != str(user.id):
        log.info("user %s chose their own Pulsar, but %s is not theirs (yet)", user.id, environment)
        return None
    return environment


def {{ _galaxy_default_dispatcher }}(app, tool, user):
    if tool.tool_type == "interactive":
        return INTERACTIVE_DESTINATION
    choice = _preferred_destination(user)
    # The preferences API stores any JSON value; only a string can name a destination.
    if not isinstance(choice, str) or not _may_run_remotely(tool):
        return DEFAULT_DESTINATION
    if choice in REMOTE_DESTINATIONS:
        return choice
    if BYOC_ENABLED and choice == BYOC_CHOICE:
        return _own_byoc_destination(app, user) or DEFAULT_DESTINATION
    return DEFAULT_DESTINATION
