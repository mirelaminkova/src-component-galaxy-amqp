# Settings for the app.yml of Pulsar server "{{ item.name }}" (src_galaxy_pulsar_amqp_configs).
# Written by the src-component-galaxy playbook; contains a password, keep it secret.
# Pulsar needs the `kombu` Python package (pip install 'pulsar-app[amqp]' or kombu).
# `?ssl=1` encrypts the connection but does not verify the server certificate; to verify it,
# also set amqp_connect_ssl_cert_reqs: required and amqp_connect_ssl_ca_certs.
message_queue_url: {{ ('pyamqp://' ~ item.name ~ ':' ~ _galaxy_rabbitmq_passwords[item.name] ~ '@' ~ _galaxy_server_fqdn ~ ':' ~ _galaxy_rabbitmq_port ~ '/' ~ item.vhost ~ '?ssl=1') | to_json }}
# Must be the jobs_directory Galaxy uses for this Pulsar.
staging_directory: {{ item.jobs_directory | to_json }}
# Galaxy's runner uses manager "{{ item.manager }}"; Pulsar must define it.
managers:
  {{ item.manager }}:
    type: queued_python
    num_concurrent_jobs: 1
    min_polling_interval: 0.5
amqp_acknowledge: true
amqp_ack_republish_time: 1200
amqp_publish_retry: true
amqp_publish_retry_max_retries: 60
amqp_publish_retry_interval_start: 10
amqp_publish_retry_interval_step: 10
amqp_publish_retry_interval_max: 60
