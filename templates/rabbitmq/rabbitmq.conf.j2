# Managed by the src-component-galaxy playbook; local changes are overwritten.

# Plain AMQP only on the loopback interface, for Galaxy on this host.
listeners.tcp.1 = 127.0.0.1:{{ _galaxy_rabbitmq_local_port }}

# AMQPS for remote Pulsar servers, with the certificate of the SRC Nginx plugin.
listeners.ssl.default = {{ _galaxy_rabbitmq_port }}
ssl_options.cacertfile = {{ _galaxy_rabbitmq_tls_dir }}/fullchain.pem
ssl_options.certfile = {{ _galaxy_rabbitmq_tls_dir }}/fullchain.pem
ssl_options.keyfile = {{ _galaxy_rabbitmq_tls_dir }}/key.pem
ssl_options.verify = verify_none
ssl_options.fail_if_no_peer_cert = false
{% for version in _galaxy_rabbitmq_tls_versions %}
ssl_options.versions.{{ loop.index }} = {{ version }}
{% endfor %}

# Erlang distribution (used by rabbitmqctl) only on the loopback interface.
distribution.listener.interface = 127.0.0.1

# The galaxy user (its password is in Galaxy's job_conf.yml) may only connect from this host;
# remote Pulsar servers use their own users over AMQPS.
loopback_users.galaxy = true
