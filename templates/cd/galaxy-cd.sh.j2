#!/bin/bash
# Managed by the src-component-galaxy playbook (galaxysrv.yml); local changes are overwritten.
#
# galaxy-cd: apply merged changes of the playbook repository to this Galaxy (issue #22).
# Runs galaxysrv.yml with ansible-pull, limited to the tags for RabbitMQ users/vhosts and the
# Galaxy config files (job config, TPV, user preferences), with the component parameters this
# workspace was created with. Galaxy is restarted gracefully by the playbook's handlers only
# when a config file changed. Output goes to the journal: journalctl -u galaxy-cd
set -uo pipefail
umask 077

venv={{ _galaxy_cd_venv | quote }}
state_dir={{ _galaxy_cd_state_dir | quote }}
config_dir={{ _galaxy_cd_config_dir | quote }}
lock_file={{ _galaxy_cd_lock_file | quote }}
vault_password_file={{ _galaxy_cd_vault_password_file | quote }}
deploy_key={{ _galaxy_cd_deploy_key | quote }}
repo={{ _galaxy_cd_repo | quote }}
branch={{ _galaxy_cd_branch | quote }}
tags={{ _galaxy_cd_tags | join(',') | quote }}

checkout="$state_dir/checkout"
failed_marker="$state_dir/last-run-failed"
params="$config_dir/params.yml"
secret_params="$config_dir/secret_params.yml"

export ANSIBLE_ROLES_PATH="$state_dir/ansible/roles"
export ANSIBLE_COLLECTIONS_PATH="$state_dir/ansible/collections"
export ANSIBLE_NOCOLOR=1
export ANSIBLE_LOCALHOST_WARNING=False

fail() {
    local rc=$1
    shift
    touch "$failed_marker"
    echo "galaxy-cd: FAILED: $* (exit code $rc). Details: journalctl -u galaxy-cd" >&2
    exit "$rc"
}

exec 9>>"$lock_file"
if ! flock --nonblock 9; then
    echo "galaxy-cd: another run is in progress (lock $lock_file), skipping this one"
    exit 0
fi

pull_args=(
    --url "$repo" --checkout "$branch" --directory "$checkout" --clean
    --inventory localhost, --tags "$tags"
    --extra-vars "@$params"
)
if [[ -f $secret_params ]]; then
    pull_args+=(--extra-vars "@$secret_params")
fi
# Never bootstrap (install tools/workflows) again; modules run with the system Python (apt, psycopg2).
pull_args+=(--extra-vars src_galaxy_bootstrap=false --extra-vars ansible_python_interpreter=/usr/bin/python3)
# In the environment rather than --vault-password-file: ansible-pull also hands the extra vars
# (secret_params.yml is vault-encrypted) to its git checkout command, but not that option.
if [[ -f $vault_password_file ]]; then
    export ANSIBLE_VAULT_PASSWORD_FILE="$vault_password_file"
fi
if [[ -f $deploy_key ]]; then
    pull_args+=(--private-key "$deploy_key" --accept-host-key)
fi
# Skip the playbook when the branch has no new commits, unless the last run failed.
if [[ -d $checkout/.git && ! -e $failed_marker ]]; then
    pull_args+=(--only-if-changed)
fi

# Roles and collections of the last checkout; a changed requirements.yml is installed on the
# run after the one that fetched it (that run fails if it needs them, so the next one retries).
if [[ -f $checkout/requirements.yml ]]; then
    "$venv/bin/ansible-galaxy" install -r "$checkout/requirements.yml" || fail $? "ansible-galaxy install -r requirements.yml"
fi

"$venv/bin/ansible-pull" "${pull_args[@]}" galaxysrv.yml
rc=$?
if (( rc != 0 )); then
    fail "$rc" "ansible-pull of $repo ($branch)"
fi
rm -f "$failed_marker"
commit=$(git -C "$checkout" rev-parse --short HEAD 2>/dev/null || echo unknown)
echo "galaxy-cd: OK: $repo ($branch) at $commit is applied"
