preferences:
{% if _galaxy_ibridges_enabled %}
    irods_config:
        description: Your iRODS account
        inputs:
            - name: username
              label: Username
              type: text
              required: True
            - name: password
              label: Data Access Password
              type: secret
              required: True
            - name: env
              label: Config
              required: True
              type: text
{% endif %}
{% if _galaxy_remote_destinations | length > 0 or _galaxy_byoc_pulsar %}
    # Read by the default_dispatcher job rule as "distributed_compute|remote_resources".
    distributed_compute:
        description: Use distributed compute resources
        inputs:
            - name: remote_resources
              label: Remote resources id
              type: select
              required: False
              options:
                  - ["default - Galaxy will decide where to put your job", None]
{% for destination in _galaxy_remote_destinations %}
                  - {{ [destination.label, destination.id] | to_json }}
{% endfor %}
{% if _galaxy_byoc_pulsar %}
                  # Only ever the user's own Pulsar (byoc_pulsar below); the job rule checks the owner.
                  - ["My own Pulsar (Bring your own Pulsar, set up below)", "byoc"]
{% endif %}
{% endif %}
{% if _galaxy_byoc_pulsar %}
    byoc_pulsar:
        # galaxy-byoc-sync (files/byoc/galaxy_byoc_sync.py) reads these values.
        description: >
            Bring your own Pulsar (experimental). Choose a RabbitMQ username and password below;
            within {{ _galaxy_byoc_sync_interval_minutes }} minutes Galaxy creates your endpoint. Then set
            message_queue_url in your Pulsar's app.yml to
            pyamqp://byoc_USERNAME:PASSWORD@{{ _galaxy_server_fqdn }}:{{ _galaxy_rabbitmq_port }}//pulsar/byoc_USERNAME?ssl=1
            and staging_directory to {{ _galaxy_byoc_jobs_directory }}, and select
            "My own Pulsar" under "Use distributed compute resources" to send your jobs there.
            Only your own jobs can run on your Pulsar.
        inputs:
            - name: username
              label: RabbitMQ custom username, 3-32 characters from a-z 0-9 _ - (e.g. mypulsarendpoint).
              type: text
              required: False
            - name: password
              label: RabbitMQ custom password, 10-128 letters and digits only (e.g. MyPulS4rP4ssw0rd).
              type: secret
              required: False
            - name: max_accepted_cores
              label: Maximum number of CPU cores available.
              type: number
              required: False
            - name: max_accepted_mem
              label: Maximum number of RAM available (in GB).
              type: number
              required: False
            - name: min_accepted_gpus
              label: Minimum number of GPU available (set this to zero if you don't want to share GPUs).
              type: number
              required: False
            - name: max_accepted_gpus
              label: Maximum number of GPU available (set this to zero if you don't want to share GPUs).
              type: number
              required: False
{% endif %}
