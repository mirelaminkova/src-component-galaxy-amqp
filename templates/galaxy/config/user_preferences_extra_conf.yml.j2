preferences:
{% if _galaxy_ibridges_enabled %}
    irods_config:
        description: Your iRODS account
        inputs:
            - name: username
              label: Username
              type: text
              required: True
            - name: password
              label: Data Access Password
              type: secret
              required: True
            - name: env
              label: Config
              required: True
              type: text
{% endif %}
{% set generated_tags = _galaxy_remote_destinations | map(attribute='tag') | list %}
{# Options from the EU-layout files/galaxy/config/user_preferences_extra_conf.yml (BYOC onboarding). #}
{% set byoc_options = _galaxy_byoc_preference_options | rejectattr(1, 'in', generated_tags) | list %}
{% if _galaxy_remote_destinations | length > 0 or byoc_options | length > 0 %}
    # Read by the TPV rule `remote_resources` (files/galaxy/tpv/tool_defaults.yml.j2) as
    # "distributed_compute|remote_resources"; the values are TPV scheduling tags (`<name>-pulsar`).
    distributed_compute:
        description: Use distributed compute resources
        inputs:
            - name: remote_resources
              label: Remote resources id
              type: select
              required: False
              options:
                  - ["default - Galaxy will decide where to put your job", None]
{% for destination in _galaxy_remote_destinations %}
                  - {{ [destination.label, destination.tag] | to_json }}
{% endfor %}
{% for option in byoc_options %}
                  - {{ option | to_json }}
{% endfor %}
{% endif %}
{% if _galaxy_byoc_pulsar %}
    byoc_pulsar:
        description: >
            Bring your own Pulsar endpoint to Galaxy. You can add here your Pulsar credentials and specifications.
            Once the administrators have reviewed and merged your endpoint, Galaxy's job scheduling systems will take your Pulsar into account {{ _galaxy_byoc_schedule_delay }}
            and schedule appropriate jobs to your compute resources; you can then pick it under "Use distributed compute resources".
            This is an experimental feature. Contact the administrators if you want to learn more about it.
        inputs:
            - name: username
              label: RabbitMQ custom username (e.g. mypulsarendpoint).
              type: text
              required: False
            - name: password
              label: RabbitMQ custom alphanumerical password, at least 10 characters long (e.g. MyPulS4rP4ssw0rd).
              type: password
              required: False
            - name: max_accepted_cores
              label: Maximum number of CPU cores available.
              type: number
              required: False
            - name: max_accepted_mem
              label: Maximum number of RAM available (in GB).
              type: number
              required: False
            - name: min_accepted_gpus
              label: Minimum number of GPU available (set this to zero if you don't want to share GPUs).
              type: number
              required: False
            - name: max_accepted_gpus
              label: Maximum number of GPU available (set this to zero if you don't want to share GPUs).
              type: number
              required: False
            - name: nfs_path
              label: Path of the NFS share your Pulsar uses for staging, persisted data and the container cache (e.g. /data/share).
              type: text
              required: False
{% endif %}
