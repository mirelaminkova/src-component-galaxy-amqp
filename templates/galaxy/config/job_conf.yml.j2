runners:
  local:
    load: galaxy.jobs.runners.local:LocalJobRunner
    workers: 4
{% if _galaxy_has_pulsar %}
  pulsar:
    load: galaxy.jobs.runners.pulsar:PulsarRESTJobRunner
{% endif %}
{% for pulsar in _galaxy_pulsar_amqp_configs %}
  # Remote Pulsar "{{ pulsar.name }}" over AMQP (src_galaxy_pulsar_amqp_configs): one runner
  # per RabbitMQ vhost. Galaxy connects as the galaxy user over plain AMQP on the loopback
  # listener; the Pulsar connects as its own user over AMQPS.
  {{ pulsar.runner }}:
    load: galaxy.jobs.runners.pulsar:PulsarMQJobRunner
    amqp_url: {{ ('pyamqp://galaxy:' ~ _galaxy_rabbitmq_passwords['galaxy'] ~ '@127.0.0.1:' ~ _galaxy_rabbitmq_local_port ~ '/' ~ pulsar.vhost) | to_json }}
    galaxy_url: {{ _galaxy_infrastructure_url | to_json }}
    manager: {{ pulsar.manager | to_json }}
    amqp_acknowledge: true
    amqp_ack_republish_time: 1200
    amqp_consumer_timeout: 2.0
    amqp_publish_retry: true
    amqp_publish_retry_max_retries: 60
{% endfor %}
{% for runner in _galaxy_byoc_runners %}
  # BYOC Pulsar runner from templates/galaxy/config/job_conf.yml (EU layout, issue #21).
  {{ runner.id }}:
    load: {{ runner.load | to_json }}
{# Keys are checked (filter_plugins/byoc_onboarding.py) and quoted, so they cannot add YAML. #}
{% for key, value in runner.params.items() %}
    {{ key | to_json }}: {{ value | to_json }}
{% endfor %}
{% endfor %}

execution:
  # Every job is routed by TPV (total-perspective-vortex); the destinations and routing rules
  # are in files/galaxy/tpv/ (rendered to {{ _galaxy_tpv_config_dir }}).
  default: tpv_dispatcher
  environments:
    # Upload, data fetch and other "local" class tools (see `tools` below), as before TPV.
    local:
      runner: local
      env:
        - name: PATH
          action: prepend_to
          value: "{{ galaxy_mutable_data_dir }}/shed_tools:$PATH"

    tpv_dispatcher:
      runner: dynamic
      type: python
      function: map_tool_to_destination
      rules_module: tpv.rules
      tpv_config_files:
        - {{ (_galaxy_tpv_config_dir ~ '/tool_defaults.yml') | to_json }}
        - {{ (_galaxy_tpv_config_dir ~ '/destinations.yml') | to_json }}

tools:
  - class: local  # expression tools, upload, etc - not parameterized for remote execution
    environment: local
